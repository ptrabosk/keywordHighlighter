{
  "manifest_version": 3,
  "name": "Offsight Highlighter",
  "description": "Highlights configured rule matches in inbound Operations messages; processes supported page content locally.",
  "version": "1.0.6",
  "homepage_url": "https://github.com/ptrabosk/keywordHighlighter",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Rule Highlighter",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://ui.attentivemobile.com/concierge/*",
    "https://script.google.com/macros/s/*",
    "https://script.googleusercontent.com/macros/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ui.attentivemobile.com/concierge/*"
      ],
      "js": [
        "settings.js",
        "src/shared/extensionUtils.js",
        "src/highlight/regexNormalization.js",
        "src/highlight/core.js",
        "src/highlight/shortcutTelemetry.js",
        "src/content/diagnostics.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/rules/opt_out_rules.json",
        "data/rules/rule_hover_text.json"
      ],
      "matches": [
        "https://ui.attentivemobile.com/*"
      ]
    }
  ]
}
