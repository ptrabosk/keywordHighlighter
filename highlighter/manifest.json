{
  "manifest_version": 3,
  "name": "Attentive Rule Highlighter",
  "description": "Highlights inbound Attentive Concierge messages using consolidated opt-out classifier rules.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Rule Highlighter",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://ui.attentivemobile.com/concierge/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ui.attentivemobile.com/concierge/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/rules/consolidated_rules.json"
      ],
      "matches": [
        "https://ui.attentivemobile.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
